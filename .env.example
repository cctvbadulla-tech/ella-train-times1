# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Database & Auth Configuration (Optional cloud integration)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"

# Resend Email Provider Configuration for Station Feedback Alerts
RESEND_API_KEY="re_123456789_placeholder"

# Station Master & Administrative Email Settings
STATION_MASTER_EMAIL="ellastation.inquiries@gmail.com"
NOTIFICATION_SENDER_EMAIL="alerts@ellatraintimes.com"
